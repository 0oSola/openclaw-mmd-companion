{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/backend/[...path]",
      "regex": "^/api/backend/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/backend/(?<nxtPpath>.+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/companion",
      "regex": "^/companion(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/companion(?:/)?$"
    },
    {
      "page": "/companion/tasks",
      "regex": "^/companion/tasks(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/companion/tasks(?:/)?$"
    },
    {
      "page": "/mmd-calibration-render",
      "regex": "^/mmd\\-calibration\\-render(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mmd\\-calibration\\-render(?:/)?$"
    },
    {
      "page": "/podcasts",
      "regex": "^/podcasts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/podcasts(?:/)?$"
    },
    {
      "page": "/status",
      "regex": "^/status(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/status(?:/)?$"
    },
    {
      "page": "/traces",
      "regex": "^/traces(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/traces(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}