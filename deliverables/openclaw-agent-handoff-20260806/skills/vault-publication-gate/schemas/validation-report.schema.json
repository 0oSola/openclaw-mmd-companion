{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vault Publication Validation Report",
  "type": "object",
  "required": [
    "policy_version",
    "check_stage",
    "checked_files",
    "approved_file_allowlist",
    "actual_changed_files",
    "document_hashes",
    "diff_hash",
    "errors",
    "warnings",
    "validator_version",
    "executed_at"
  ],
  "properties": {
    "policy_version": {"type": ["string", "null"]},
    "check_stage": {"enum": ["preflight", "post-apply"]},
    "checked_files": {"type": "array", "items": {"type": "string"}},
    "approved_file_allowlist": {"type": "array", "items": {"type": "string"}},
    "actual_changed_files": {"type": "array", "items": {"type": "string"}},
    "document_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "diff_hash": {"type": ["string", "null"]},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "validator_version": {"type": "string"},
    "executed_at": {"type": "string"}
  }
}
